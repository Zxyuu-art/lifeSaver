<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container nav">
        <div class="brand">LifeSaver</div>
        <nav>
          <a href="/dashboard">Dashboard</a>
          <a href="/urusan/new">+ Tambah</a>
          <a href="/timeline">Timeline</a>
          <a href="/notifications">Notifikasi</a>
          <a href="/logout">Logout</a>
        </nav>
      </div>
    </header>

    <main class="page">
      <div class="container">
        <div class="page-header">
          <div>
            <p class="eyebrow">Detail urusan</p>
            <h1>Rincian Kegiatan</h1>
          </div>
          <div class="status-row">
            <a href="/dashboard" class="btn secondary">Kembali</a>
            <a href="/urusan/<%= task.id %>/edit" class="btn primary">Edit</a>
          </div>
        </div>

        <div class="detail-layout">
          <section class="detail-card">
            <div class="detail-header">
              <h2 class="detail-title"><%= task.name %></h2>
              <span class="badge <%= task.urgency %>"><%= task.urgency %></span>
            </div>

            <div class="meta-grid">
              <div class="meta-item">
                <span>Kategori</span>
                <strong><%= task.category %></strong>
              </div>
              <div class="meta-item">
                <span>Jatuh tempo</span>
                <strong><%= new Date(task.due_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></strong>
              </div>
              <div class="meta-item">
                <span>Pengulangan</span>
                <strong><%= task.recurring_type %></strong>
              </div>
              <div class="meta-item">
                <span>Reminder</span>
                <strong><%= task.reminder_days || '3,1' %></strong>
              </div>
            </div>

            <div class="panel">
              <h3>Catatan</h3>
              <p><%= task.description || 'Tidak ada catatan tambahan.' %></p>
            </div>

            <div class="panel">
              <h3>Reminder otomatis</h3>
              <% if (reminders.length) { %>
                <ul class="reminder-list">
                  <% reminders.forEach((reminder) => { %>
                    <li>
                      <span><%= reminder.days_before %> hari sebelum</span>
                      <span class="badge <%= reminder.status === 'pending' ? 'upcoming' : 'safe' %>"><%= reminder.status %></span>
                    </li>
                  <% }) %>
                </ul>
              <% } else { %>
                <p class="muted-text">Belum ada pengaturan reminder.</p>
              <% } %>
            </div>
          </section>

          <aside class="detail-card">
            <h3>Dokumen</h3>
            <% if (documents.length) { %>
              <ul class="doc-list">
                <% documents.forEach((doc) => { %>
                  <li>
                    <div>
                      <strong><%= doc.file_name %></strong>
                    </div>
                    <div class="doc-actions">
                      <a class="text-link" href="/documents/<%= doc.id %>/download">Unduh</a>
                      <form method="POST" action="/documents/<%= doc.id %>/delete" onsubmit="return confirm('Hapus dokumen ini?')">
                        <button type="submit" class="text-link danger">Hapus</button>
                      </form>
                    </div>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <p class="muted-text">Belum ada dokumen yang diupload.</p>
            <% } %>

            <form method="POST" action="/urusan/<%= task.id %>/upload" enctype="multipart/form-data" class="inline-form">
              <input type="file" name="document" accept=".pdf,.jpg,.jpeg,.png" />
              <button type="submit" class="btn primary">Upload</button>
            </form>

            <div class="status-row" style="margin-top: 24px;">
              <form method="POST" action="/urusan/<%= task.id %>/delete" onsubmit="return confirm('Hapus urusan ini?')">
                <button type="submit" class="btn secondary">Hapus Urusan</button>
              </form>
            </div>
          </aside>
        </div>
      </div>
    </main>
  </body>
</html>
